
/* Home page styles */

:root {
  --vp-home-hero-name-color: transparent;
  --vp-home-hero-name-background: linear-gradient(-60deg, var(--vp-c-brand-2) 10%, var(--vp-c-brand-1));
  --vp-home-hero-image-background-image: linear-gradient(-45deg, var(--vp-c-brand-2) 10%, var(--vp-c-brand-1));
  --vp-home-hero-image-filter: blur(44px);  
}

@media (min-width: 640px) {
  :root {
    --vp-home-hero-image-filter: blur(56px);
  }
}

@media (min-width: 960px) {
  :root {
    --vp-home-hero-image-filter: blur(68px);
  }
}

.VPHero .VPImage {
  opacity: 0.7;
  padding: 18px;
}

.VPHero .text {
  font-size: 2.5rem;
  line-height: 1.5;
  padding: 10px 0;
}

.VPHero .tagline {
  font-size: 1.5rem;
  line-height: 1.5;
  font-style: italic;
  white-space: nowrap;
}

a.VPFeature {
  border: 1px solid transparent !important;
  background:
    linear-gradient(var(--vp-c-bg-soft), var(--vp-c-bg-soft)) padding-box,
    linear-gradient(-60deg, 
      color-mix(in srgb, var(--vp-c-brand-2) 50%, transparent) 10%,
      color-mix(in srgb, var(--vp-c-brand-1) 50%, transparent)
    ) border-box !important;
}

a.VPFeature:hover {
  background:
    linear-gradient(var(--vp-c-bg-soft), var(--vp-c-bg-soft)) padding-box,
    linear-gradient(-60deg, var(--vp-c-brand-2) 10%, var(--vp-c-brand-1)) border-box !important;
  
  .title {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--vp-c-brand-2) 50%, transparent);
    text-underline-offset: 4px;
  }
}

a.VPFeature .SubFeatures {
  display: flex;
  margin-top: 8px;
  gap: 8px;
}

a.VPFeature .SubFeatures a.SubFeature {
  color: var(--vp-c-brand-1) !important;
  padding: 4px 8px;
  border-radius: 4px;
  border: 1px solid var(--vp-c-brand-soft);
  /* background-color: var(--vp-c-default-soft); */
  background:
    linear-gradient(var(--vp-c-bg-soft), var(--vp-c-bg-soft)) padding-box,
    linear-gradient(-60deg, 
      color-mix(in srgb, var(--vp-c-brand-2) 20%, transparent) 10%,
      color-mix(in srgb, var(--vp-c-brand-1) 20%, transparent)
    ) border-box !important;
}

a.VPFeature .SubFeatures a.SubFeature:hover {
  color: var(--vp-c-brand-2) !important;
  background:
    linear-gradient(var(--vp-c-bg-soft), var(--vp-c-bg-soft)) padding-box,
    linear-gradient(-60deg, 
      color-mix(in srgb, var(--vp-c-brand-2) 50%, transparent) 10%,
      color-mix(in srgb, var(--vp-c-brand-1) 50%, transparent)
    ) border-box !important;
}

a.VPFeature .SubFeatures a.SubFeature img {
  display: inline;
  vertical-align: middle;
  width: 20px;
  height: 20px;
  margin-right: 4px;
}
